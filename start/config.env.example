# Web AutoTest Agent 用户启动配置。
# 第一次使用时，把本文件复制为 config.env，然后填写你的模型服务信息。

# OpenAI 兼容模型服务的 API Key；如果你的本地模型网关不需要 Key，可以留空。
OPENAI_API_KEY=

# OpenAI 兼容接口基础地址；使用官方 OpenAI 时可以留空。
OPENAI_BASE_URL=

# Master Agent 使用的模型，建议使用支持结构化输出的模型。
MASTER_MODEL=openai:gpt-4.1

# Plan、Generator、Healer 等 Specialist Agent 使用的模型。
SPECIALIST_MODEL=openai:gpt-5.4

# 自动化工程根目录；Agent 会在这里创建或复用测试工程。
DEFAULT_AUTOMATION_PROJECT_ROOT=~/webautotest

# Playwright MCP 是否以有头模式启动浏览器。
PWTEST_HEADED=true

# 首次启动是否安装 Playwright Chromium 浏览器。
START_INSTALL_PLAYWRIGHT_BROWSERS=true

# 设为 1 时强制重新同步 Python 与前端依赖。
START_FORCE_SETUP=0
