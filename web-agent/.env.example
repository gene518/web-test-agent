#---------------model-adapter-v2----------------
# MODEL_ADAPTER_V2_ENABLED: 新模型适配层总开关；紧急回滚时可临时设为 false。
MODEL_ADAPTER_V2_ENABLED=true
#---------------model-adapter-v2----------------

#---------------master-llm----------------
# Qwen 3.5+ / DashScope 示例（推荐用于 Master 时关闭 thinking）：
# MASTER_LLM__FAMILY: Master 模型家族，用于选择能力适配；可选 openai/qwen/minimax/glm/generic。
#MASTER_LLM__FAMILY=qwen
# MASTER_LLM__CHANNEL: Master 实际接入通道；Qwen 通过 DashScope OpenAI 兼容接口时填写 dashscope_openai。
#MASTER_LLM__CHANNEL=dashscope_openai
# MASTER_LLM__MODEL: Master 请求供应商接口时使用的模型 ID；新配置无需添加 openai: 前缀。
#MASTER_LLM__MODEL=qwen3.5-plus
# MASTER_LLM__API_KEY: Master 独立使用的真实 API Key。
#MASTER_LLM__API_KEY=
# MASTER_LLM__BASE_URL: Master 模型接口基础地址，不包含 chat/completions 等具体资源路径。
#MASTER_LLM__BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# MASTER_LLM__THINKING: Master 思考模式；可选 auto/enabled/disabled，结构化分类推荐 disabled。
#MASTER_LLM__THINKING=disabled
#---------------master-llm----------------

#---------------specialist-llm----------------
# MiniMax 2.7+ / Anthropic 兼容示例（推荐用于 Specialist 长工具链）：
# SPECIALIST_LLM__FAMILY: Specialist 模型家族，用于选择能力适配；可选 openai/qwen/minimax/glm/generic。
#SPECIALIST_LLM__FAMILY=minimax
# SPECIALIST_LLM__CHANNEL: Specialist 实际接入通道；MiniMax Anthropic 兼容接口填写 minimax_anthropic。
#SPECIALIST_LLM__CHANNEL=minimax_anthropic
# SPECIALIST_LLM__MODEL: Plan、Generator、Healer 等 Specialist 使用的供应商模型 ID。
#SPECIALIST_LLM__MODEL=MiniMax-M2.7
# SPECIALIST_LLM__API_KEY: Specialist 独立使用的真实 API Key。
#SPECIALIST_LLM__API_KEY=
# SPECIALIST_LLM__BASE_URL: Specialist 模型接口基础地址；此示例使用 MiniMax Anthropic 兼容入口。
#SPECIALIST_LLM__BASE_URL=https://api.minimax.io/anthropic
# SPECIALIST_LLM__THINKING: Specialist 思考模式；可选 auto/enabled/disabled，M2.x 建议使用 auto。
#SPECIALIST_LLM__THINKING=auto

# GLM 5.2+ / 智谱 OpenAI 兼容示例：
# SPECIALIST_LLM__FAMILY: Specialist 模型家族；GLM 5.2+ 填写 glm。
#SPECIALIST_LLM__FAMILY=glm
# SPECIALIST_LLM__CHANNEL: Specialist 实际接入通道；智谱 OpenAI 兼容接口填写 zhipu_openai。
#SPECIALIST_LLM__CHANNEL=zhipu_openai
# SPECIALIST_LLM__MODEL: Specialist 请求智谱接口时使用的模型 ID。
#SPECIALIST_LLM__MODEL=glm-5.2
# SPECIALIST_LLM__API_KEY: Specialist 请求智谱接口时直接使用的真实 API Key。
#SPECIALIST_LLM__API_KEY=
# SPECIALIST_LLM__BASE_URL: 智谱 OpenAI 兼容接口基础地址。
#SPECIALIST_LLM__BASE_URL=https://open.bigmodel.cn/api/paas/v4/
# SPECIALIST_LLM__THINKING: GLM 思考模式；可选 auto/enabled/disabled。
#SPECIALIST_LLM__THINKING=enabled
# SPECIALIST_LLM__REASONING_EFFORT: GLM 推理强度；是否支持及可选值以接入通道文档为准。
#SPECIALIST_LLM__REASONING_EFFORT=max
#---------------specialist-llm----------------

#---------------legacy-model-config----------------
# OPENAI_API_KEY: 旧配置使用的 OpenAI 兼容接口 API Key。
OPENAI_API_KEY=
# OPENAI_BASE_URL: 旧配置使用的 OpenAI 兼容接口基础地址。
OPENAI_BASE_URL=
# MASTER_MODEL: 旧配置中的 Master 模型，建议写成 provider:model 形式。
#MASTER_MODEL=
# SPECIALIST_MODEL: 旧配置中的 Specialist 模型，建议写成 provider:model 形式。
#SPECIALIST_MODEL=
#---------------legacy-model-config----------------

#----master----
# MAX_CONVERSATION_TURNS: Master 在缺参追问流程中允许的最大用户轮次。
MAX_CONVERSATION_TURNS=20
# LLM_TIMEOUT_SECONDS: 单次模型调用的超时时间，单位秒。
LLM_TIMEOUT_SECONDS=600
# LLM_ENABLE_THINKING: 仅用于旧配置兼容；新配置请分别使用 MASTER_LLM__THINKING / SPECIALIST_LLM__THINKING。
LLM_ENABLE_THINKING=false
# SPECIALIST_RECURSION_LIMIT: Specialist Deep Agent 执行时传给 LangGraph 的递归步数上限。
SPECIALIST_RECURSION_LIMIT=999


#----test----
# LOG_LEVEL: 项目运行期日志等级，例如 INFO、DEBUG、WARNING。
LOG_LEVEL=INFO
# AGENT_DEBUG_TRACE: 是否开启本地深度调试日志。
AGENT_DEBUG_TRACE=false
# AGENT_DEBUG_FULL_MESSAGES: 是否输出完整 system/user/ai/tool 消息和最终提示词。
AGENT_DEBUG_FULL_MESSAGES=false
# AGENT_DEBUG_MAX_CHARS: 深度调试日志中单段文本的最大字符数。
AGENT_DEBUG_MAX_CHARS=4000

#----PWTEST----
# PWTEST_HEADED: Playwright Test MCP 是否以有头模式启动浏览器。
PWTEST_HEADED=true
# PLAYWRIGHT_BOOTSTRAP_WORKSPACE: 启动 Playwright Test MCP 前是否自动补齐 npm 与 `@playwright/test` 依赖。
PLAYWRIGHT_BOOTSTRAP_WORKSPACE=true
# PLAYWRIGHT_MCP_PACKAGE: MCP 服务固定使用的 Playwright Test 包版本。
PLAYWRIGHT_MCP_PACKAGE=@playwright/test@1.61.1
# PLAYWRIGHT_TEST_PACKAGE: 自动化工程缺少依赖时安装的 Playwright Test 包版本。
PLAYWRIGHT_TEST_PACKAGE=@playwright/test@1.61.1
# DEFAULT_AUTOMATION_PROJECT_ROOT: 自动化工程根目录；默认在用户根目录下的 `webautotest` 目录。
DEFAULT_AUTOMATION_PROJECT_ROOT=~/webautotest

#----scheduler----
# SCHEDULER_CONFIG_PATH: 独立定时执行服务读取的任务配置文件路径；留空时默认使用服务端 `web-agent/scheduler_tasks.json`，相对路径也以 `web-agent` 为基准。
SCHEDULER_CONFIG_PATH=
# SCHEDULER_POLL_INTERVAL_SECONDS: 独立定时执行服务扫描配置文件并检查到点任务的轮询间隔，单位秒。
SCHEDULER_POLL_INTERVAL_SECONDS=30

#----LANGSMITH----
# LANGSMITH_API_KEY: LangSmith API Key；开启 tracing 时填写。
LANGSMITH_API_KEY=
# LANGSMITH_PROJECT: LangSmith 项目名；用于区分不同运行环境或项目。
LANGSMITH_PROJECT=
# LANGSMITH_TRACING: 是否开启 LangSmith tracing。
LANGSMITH_TRACING=false

# PYTHONDONTWRITEBYTECODE: 是否禁止 Python 运行时生成 `.pyc` 和 `__pycache__`。
PYTHONDONTWRITEBYTECODE=1

#----start----
# START_FORCE_SETUP: 设为 1 时，启动脚本会强制重新同步 Python 与前端依赖。
START_FORCE_SETUP=0
# START_INSTALL_PLAYWRIGHT_BROWSERS: 首次启动时是否安装 Playwright Chromium 浏览器。
START_INSTALL_PLAYWRIGHT_BROWSERS=true
# OPEN_BROWSER: 设为 0 时，启动脚本不会自动打开前端页面。
OPEN_BROWSER=1
# FRONTEND_OPEN_URL: 留空时使用启动脚本自动推导的前端地址。
FRONTEND_OPEN_URL=
