#----role-model-config----
# Master 和 Specialist 必须分别配置，两组之间不会继承或回退。
# FAMILY 可选 openai、qwen、minimax、glm、generic。
# CHANNEL 可选 openai、dashscope_openai、minimax_openai、minimax_anthropic、
# zhipu_openai、generic_openai、generic_anthropic，必须与 FAMILY 匹配。
# MODEL 填写模型服务端的真实 ID，不要添加 `openai:` 或 `anthropic:` 前缀。
# API_KEY 和 BASE_URL 可以留空；THINKING 可选 auto、enabled、disabled。

# Master Agent 模型配置。
MASTER_LLM__FAMILY=generic
MASTER_LLM__CHANNEL=generic_openai
MASTER_LLM__MODEL=gpt-5.6-terra
MASTER_LLM__API_KEY=
MASTER_LLM__BASE_URL=
MASTER_LLM__THINKING=disabled

# Plan、Generator、Healer 等 Specialist Agent 共用的模型配置。
SPECIALIST_LLM__FAMILY=generic
SPECIALIST_LLM__CHANNEL=generic_openai
SPECIALIST_LLM__MODEL=gpt-5.6-terra
SPECIALIST_LLM__API_KEY=
SPECIALIST_LLM__BASE_URL=
SPECIALIST_LLM__THINKING=disabled
#----role-model-config----

#----master----
# MAX_CONVERSATION_TURNS: Master 在缺参追问流程中允许的最大用户轮次。
MAX_CONVERSATION_TURNS=20
# LLM_TIMEOUT_SECONDS: 单次模型调用的超时时间，单位秒。
LLM_TIMEOUT_SECONDS=600
# SPECIALIST_RECURSION_LIMIT: Specialist Deep Agent 执行时传给 LangGraph 的递归步数上限。
SPECIALIST_RECURSION_LIMIT=999


#----test----
# LOG_LEVEL: 项目运行期日志等级，例如 INFO、DEBUG、WARNING。
LOG_LEVEL=INFO
# AGENT_DEBUG_TRACE: 是否开启本地深度调试日志。
AGENT_DEBUG_TRACE=false
# AGENT_DEBUG_FULL_MESSAGES: 是否输出完整 system/user/ai/tool 消息和最终提示词。
AGENT_DEBUG_FULL_MESSAGES=false
# AGENT_DEBUG_MAX_CHARS: 深度调试日志中单段文本的最大字符数。
AGENT_DEBUG_MAX_CHARS=4000

#----PWTEST----
# PWTEST_HEADED: Playwright Test MCP 是否以有头模式启动浏览器。
PWTEST_HEADED=true
# PLAYWRIGHT_BOOTSTRAP_WORKSPACE: 启动 Playwright Test MCP 前是否自动补齐 npm 与 `@playwright/test` 依赖。
PLAYWRIGHT_BOOTSTRAP_WORKSPACE=true
# PLAYWRIGHT_TEST_PACKAGE: 自动化工程缺少 Playwright Test 依赖时执行 npm install 使用的包名或版本规格。当前 Agent 支持版本 1.61.1。
PLAYWRIGHT_TEST_PACKAGE=@playwright/test@1.61.1
# DEFAULT_AUTOMATION_PROJECT_ROOT: 自动化工程根目录；默认在用户根目录下的 `webautotest` 目录。
DEFAULT_AUTOMATION_PROJECT_ROOT=~/webautotest
# START_INSTALL_PLAYWRIGHT_BROWSERS: 首次启动时是否安装 Playwright Chromium 浏览器。
START_INSTALL_PLAYWRIGHT_BROWSERS=true

#----scheduler----
# SCHEDULER_CONFIG_PATH: 独立定时执行服务读取的任务配置文件路径；留空时默认使用服务端 `web-agent/scheduler_tasks.json`，相对路径也以 `web-agent` 为基准。
SCHEDULER_CONFIG_PATH=
# SCHEDULER_POLL_INTERVAL_SECONDS: 独立定时执行服务扫描配置文件并检查到点任务的轮询间隔，单位秒。
SCHEDULER_POLL_INTERVAL_SECONDS=30
# SCHEDULER_LANGGRAPH_URL: Scheduler 创建只读监控对话并运行 scheduled-run 图的 LangGraph API；Docker Compose 内设置为 http://app:2024。
SCHEDULER_LANGGRAPH_URL=http://127.0.0.1:2024
# SCHEDULER_LANGGRAPH_API_KEY: 远程 LangGraph 部署可填写 API Key；本地私有部署留空。
SCHEDULER_LANGGRAPH_API_KEY=
# SCHEDULER_LANGGRAPH_TIMEOUT_SECONDS: 等待 scheduled-run 图完成的 HTTP 超时时间，单位秒。
SCHEDULER_LANGGRAPH_TIMEOUT_SECONDS=3600
# SCHEDULER_SCHEDULED_RUN_GRAPH_ID: 定时执行、分析与自动修复使用的独立图 ID。
SCHEDULER_SCHEDULED_RUN_GRAPH_ID=web-autotest-scheduled-run
# SCHEDULER_MONITOR_HEARTBEAT_SECONDS: 有新输出时发布监控心跳的最小间隔。
SCHEDULER_MONITOR_HEARTBEAT_SECONDS=30
# SCHEDULER_AUTO_HEAL_ENABLED: 仅允许高置信 test_automation 问题自动调用一次 Healer。
SCHEDULER_AUTO_HEAL_ENABLED=true
# SCHEDULER_AUTO_HEAL_CONFIDENCE_THRESHOLD: 自动 Healer 最低结构化归因置信度。
SCHEDULER_AUTO_HEAL_CONFIDENCE_THRESHOLD=0.8

#----LANGSMITH----
# LANGSMITH_API_KEY: LangSmith API Key；开启 tracing 时填写。
LANGSMITH_API_KEY=
# LANGSMITH_PROJECT: LangSmith 项目名；用于区分不同运行环境或项目。
LANGSMITH_PROJECT=
# LANGSMITH_TRACING: 是否开启 LangSmith tracing。
LANGSMITH_TRACING=false

# PYTHONDONTWRITEBYTECODE: 是否禁止 Python 运行时生成 `.pyc` 和 `__pycache__`。
PYTHONDONTWRITEBYTECODE=1

#----start----
# START_FORCE_SETUP: 设为 1 时，启动脚本会强制同步客户端、后端依赖并重新准备浏览器。
START_FORCE_SETUP=0

# BACKEND_JOBS_PER_WORKER: 源码启动时每个 LangGraph worker 的并发任务上限，必须为正整数。
BACKEND_JOBS_PER_WORKER=4
