{
	admin off
	auto_https off
}

:8080 {
	route /health {
		respond "ok" 200
	}
	route /health/agent {
		uri replace /health/agent /info
		reverse_proxy agent:2024
	}
	route /health/update {
		uri replace /health/update /health
		reverse_proxy updater:8090
	}

	route {
		basic_auth {
			{$H5_BASIC_AUTH_USER} {$H5_BASIC_AUTH_HASH}
		}

		header {
			-Server
			Content-Security-Policy "default-src 'self'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'; connect-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self'; object-src 'none'"
			Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
			Referrer-Policy "no-referrer"
			X-Content-Type-Options "nosniff"
			X-Frame-Options "DENY"
		}

		@langgraph_write {
			path /api/langgraph/*
			method POST PUT PATCH DELETE
		}
		handle @langgraph_write {
			forward_auth updater:8090 {
				uri /gate
				header_up X-Internal-Token {$UPDATE_INTERNAL_TOKEN}
			}
			uri strip_prefix /api/langgraph
			reverse_proxy agent:2024 {
				flush_interval -1
			}
		}

		handle_path /api/langgraph/* {
			reverse_proxy agent:2024 {
				flush_interval -1
			}
		}

		handle /api/artifacts/* {
			uri strip_prefix /api
			reverse_proxy agent:2024
		}

		handle_path /api/update/* {
			reverse_proxy updater:8090 {
				header_up X-Internal-Token {$UPDATE_INTERNAL_TOKEN}
			}
		}

		handle {
			root * /srv
			try_files {path} /index.html
			file_server
		}
	}
}
