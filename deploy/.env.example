# 复制后立即执行 `chmod 600 deploy/.env`；这是本机部署配置，绝不提交 Git。
# H5 当前目标方案仅使用 HTTP，且不提供登录认证；默认仅监听本机。
H5_BIND_ADDRESS=127.0.0.1
H5_PORT=8080

# 需要从其他设备访问时，可改为 0.0.0.0；仅可用于受控网络或可信 VPN。

# 必须是宿主机绝对路径；Agent 与 Scheduler 通过 bind mount 读写这些目录。
PROJECTS_HOST_PATH=/absolute/path/to/web-test-agent/deploy/data/projects
CONFIG_HOST_PATH=/absolute/path/to/web-test-agent/deploy/data/config
