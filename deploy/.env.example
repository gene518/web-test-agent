# 复制后立即执行 `chmod 600 .env`，该文件包含模型和部署密钥，绝不提交 Git。
# H5 当前目标方案仅使用 HTTP；不要填写 https://。
PUBLIC_ORIGIN=http://YOUR_VPS_IP:8080
H5_BIND_ADDRESS=0.0.0.0
H5_PORT=8080

# 执行 `docker run --rm caddy:2.10.2-alpine caddy hash-password --plaintext '强密码'`。
# 把 hash 中的每个 $ 写成 $$ 后粘贴到 Compose .env。
H5_BASIC_AUTH_USER=admin
H5_BASIC_AUTH_HASH=

# 两个值必须分别使用至少 32 字节的独立随机字符串：openssl rand -hex 32
UPDATE_INTERNAL_TOKEN=
UPDATE_CSRF_SECRET=

# Master 与 Specialist 不继承，必须分别填写完整模型配置。
MASTER_LLM__FAMILY=generic
MASTER_LLM__CHANNEL=generic_openai
MASTER_LLM__MODEL=
MASTER_LLM__API_KEY=
MASTER_LLM__BASE_URL=
MASTER_LLM__THINKING=disabled
SPECIALIST_LLM__FAMILY=generic
SPECIALIST_LLM__CHANNEL=generic_openai
SPECIALIST_LLM__MODEL=
SPECIALIST_LLM__API_KEY=
SPECIALIST_LLM__BASE_URL=
SPECIALIST_LLM__THINKING=disabled

# 必须是宿主机绝对路径；reconciler 通过 Docker socket 在宿主机重建服务。
DEPLOY_HOST_PATH=/absolute/path/to/web-test-agent/deploy
PROJECTS_HOST_PATH=/absolute/path/to/web-test-agent/deploy/data/projects
CONFIG_HOST_PATH=/absolute/path/to/web-test-agent/deploy/data/config

GITHUB_REPOSITORY=gene518/web-test-agent
GHCR_IMAGE_PREFIX=ghcr.io/gene518/web-test-agent
GITHUB_TOKEN=
GHCR_USERNAME=
GHCR_TOKEN=
DEPLOYED_SHA=0000000000000000000000000000000000000000
